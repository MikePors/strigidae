diff --git a/internal/sync/retry.go b/internal/sync/retry.go
new file mode 100644
index 0000000..3333333
--- /dev/null
+++ b/internal/sync/retry.go
@@ -0,0 +1,14 @@
+package sync
+
+import "context"
+
+// Retry runs fn with exponential backoff.
+func Retry(ctx context.Context, attempts int, fn func() error) error {
+	var err error
+	for i := 0; i < attempts; i++ {
+		if err = fn(); err == nil {
+			return nil
+		}
+	}
+	return err
+}
